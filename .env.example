# ==============================================
# Cloud Agent Service Configuration
# ==============================================

# Provider Selection
# Options: openai, anthropic, google, local
CLOUD_AGENT_PROVIDER=openai

# Default Model
CLOUD_AGENT_DEFAULT_MODEL=gpt-4

# ==============================================
# Rate Limiting Configuration
# ==============================================

# Maximum requests per minute
CLOUD_AGENT_RATE_LIMIT=60

# Maximum concurrent requests
CLOUD_AGENT_MAX_CONCURRENT=5

# ==============================================
# Retry Configuration
# ==============================================

# Maximum number of retry attempts
CLOUD_AGENT_MAX_RETRIES=3

# Initial retry delay in milliseconds
CLOUD_AGENT_RETRY_DELAY=1000

# Maximum retry delay in milliseconds
CLOUD_AGENT_MAX_RETRY_DELAY=10000

# Backoff multiplier for exponential backoff
CLOUD_AGENT_BACKOFF_MULTIPLIER=2

# ==============================================
# Batch Processing Configuration
# ==============================================

# Maximum batch size
CLOUD_AGENT_BATCH_SIZE=10

# Delay between batches in milliseconds
CLOUD_AGENT_BATCH_DELAY=100

# ==============================================
# Timeout Configuration
# ==============================================

# Request timeout in milliseconds
CLOUD_AGENT_TIMEOUT=60000

# ==============================================
# OpenAI Configuration
# ==============================================

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORGANIZATION=your-org-id-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================
# Anthropic Configuration
# ==============================================

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ==============================================
# Google AI Configuration
# ==============================================

GOOGLE_AI_API_KEY=your-google-ai-api-key-here
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1

# ==============================================
# Local Agent Configuration
# ==============================================

LOCAL_AGENT_ENDPOINT=http://localhost:8000
LOCAL_AGENT_API_KEY=your-local-agent-api-key-here

# ==============================================
# Logging Configuration
# ==============================================

# Enable/disable logging (true/false)
CLOUD_AGENT_LOGGING=true

# Log level: debug, info, warn, error
CLOUD_AGENT_LOG_LEVEL=info

# Log requests (true/false)
CLOUD_AGENT_LOG_REQUESTS=false

# Log responses (true/false)
CLOUD_AGENT_LOG_RESPONSES=false
