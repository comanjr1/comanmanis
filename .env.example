# Email Service Configuration
# Choose your email service provider: sendgrid, mailgun, ses, smtp
EMAIL_SERVICE=sendgrid

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your Company Name

# Mailgun Configuration
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=Your Company Name

# AWS SES Configuration
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_FROM_NAME=Your Company Name

# SMTP Configuration (Generic)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Your Company Name

# Multiple SMTP Support (optional, JSON array)
# Example:
# SMTP_POOL_CONFIG=[{"host":"smtp1.gmail.com","port":587,"secure":false,"user":"user1@gmail.com","pass":"app_password_1"}]
SMTP_POOL_CONFIG=[]

# Email Sending Configuration
# Rate limiting (emails per second)
EMAIL_RATE_LIMIT=10
# Maximum retries on failure
EMAIL_MAX_RETRIES=3
# Retry delay in milliseconds
EMAIL_RETRY_DELAY=1000
# Batch size for bulk sending
EMAIL_BATCH_SIZE=50

# Queue Management
EMAIL_ENABLE_QUEUE=true
EMAIL_QUEUE_PROCESS_INTERVAL_MS=2000
EMAIL_QUEUE_MAX_RETRIES=3
EMAIL_QUEUE_RETRY_BASE_DELAY_MS=1000
EMAIL_QUEUE_CLEANUP_AFTER_DAYS=7

# Email Verification
EMAIL_AUTO_VALIDATE=true
EMAIL_VALIDATE_REGEX=true
EMAIL_VALIDATE_MX=true
EMAIL_VALIDATE_SMTP=false

# Automation
EMAIL_AUTOMATION_ENABLED=true
EMAIL_AUTO_PROCESS_QUEUE=true
EMAIL_AUTO_CLEANUP=true
EMAIL_CLEANUP_INTERVAL_MS=3600000
EMAIL_DAILY_REPORT_HOUR=0
EMAIL_DAILY_REPORT_MINUTE=5

# Reporting & Monitoring
EMAIL_REPORTING_ENABLED=true
EMAIL_REPORTS_DIR=logs/reports
EMAIL_ERROR_LOG_FILE=logs/error.log

# Email Tracking
EMAIL_TRACK_OPENS=true
EMAIL_TRACK_CLICKS=true

# Reply-To Configuration
EMAIL_REPLY_TO=support@yourdomain.com

# Unsubscribe Configuration
EMAIL_UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe
